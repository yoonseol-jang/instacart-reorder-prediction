#!/bin/bash
#SBATCH --job-name=final_adaboost
#SBATCH --account=ds_ga_1003-2026sp
#SBATCH --partition=n2c48m24
#SBATCH --requeue
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=24G
#SBATCH --time=03:00:00
#SBATCH --output=/scratch/%u/instacart/logs/final_adaboost_%j.out
#SBATCH --error=/scratch/%u/instacart/logs/final_adaboost_%j.err

module purge
source /share/apps/pyenv/py3.9/etc/profile.d/conda.sh
conda activate instacart

PROJECT=/scratch/$USER/instacart
DATA=$PROJECT/data/processed
mkdir -p $PROJECT/logs

echo "=== final_adaboost  job=$SLURM_JOB_ID  node=$(hostname)  $(date) ==="

python $PROJECT/src/train_adaboost.py \
    --mode final \
    --data-dir $DATA \
    --out-dir $PROJECT \
    --n-jobs $SLURM_CPUS_PER_TASK \
    --run-tag final

echo "=== Done $(date) ==="
